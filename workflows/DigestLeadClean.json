      "id": "436bfab5-b8bc-4b4b-aec4-6fe1725f9290",
      "name": "On form submission"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $('Trimming').item.json;\n\nlet score = 0;\n\nconst email = data.Email || \"\";\nconst personalDomains = [\"gmail.com\", \"yahoo.com\", \"hotmail.com\", \"outlook.com\"];\nconst domain = email.split(\"@\")[1] || \"\";\nif (domain && !personalDomains.includes(domain)) score += 2;\n\nconst budget = data.Budget || \"\";\nif (budget === \"$5000+\") score += 3;\nelse if (budget === \"$1000-$5000\") score += 2;\nelse if (budget === \"$1000 or under\") score += 1;\n\nconst message = data.Message || \"\";\nif (message.length > 100) score += 2;\nelse if (message.length > 30) score += 1;\n\nconst keywords = [\"urgent\", \"asap\", \"pricing\", \"quote\", \"ready to start\"];\nconst lowerMsg = message.toLowerCase();\nif (keywords.some(word => lowerMsg.includes(word))) score += 2;\n\nreturn {\n  json: {\n    ...data,\n    score: score\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
